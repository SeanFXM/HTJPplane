# =============================================================================
# Plane on Railway — environment variables for the All-In-One service.
# Copy each of these into the Railway service's "Variables" tab.
# (This file is documentation; Railway reads vars from the dashboard, not here.)
# =============================================================================

# --- Public address ----------------------------------------------------------
# Your custom domain or the *.up.railway.app domain (no scheme).
DOMAIN_NAME=plane.example.com
APP_PROTOCOL=https
# Live reaches Django over loopback inside the AIO container.
API_BASE_URL=http://127.0.0.1:3004
LIVE_BASE_URL=https://plane.example.com
LIVE_BASE_PATH=/live
# Caddy listens on Railway's injected $PORT automatically — do NOT set SITE_ADDRESS.

# --- Postgres ----------------------------------------------------------------
# Add Railway's Postgres plugin and reference its connection string:
#   DATABASE_URL=${{Postgres.DATABASE_URL}}
DATABASE_URL=

# --- Redis (cache + celery result backend) -----------------------------------
# Add Railway's Redis plugin and reference it:
#   REDIS_URL=${{Redis.REDIS_URL}}
REDIS_URL=

# --- RabbitMQ (celery broker) — use a FREE external one to drop the container -
# CloudAMQP "Little Lemur" free plan -> copy the AMQP URL it gives you.
# Format: amqps://user:pass@host/vhost
AMQP_URL=

# --- Object storage: Cloudflare R2 (free tier, zero egress) ------------------
# In Cloudflare: create an R2 bucket + an API token (Account R2 -> Manage Tokens).
USE_MINIO=0
MINIO_ENDPOINT_SSL=1
AWS_REGION=auto
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=plane-uploads
BUCKET_NAME=plane-uploads
# R2 S3 endpoint: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
AWS_S3_ENDPOINT_URL=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
FILE_SIZE_LIMIT=5242880

# --- Secrets (generate your own!) --------------------------------------------
# python -c "import secrets;print(secrets.token_hex(32))"
SECRET_KEY=
LIVE_SERVER_SECRET_KEY=

# --- Right-sizing (the actual cost knobs) ------------------------------------
# Two gunicorn workers prevent one slow request from stalling every API call.
# Set this back to 1 only if the AIO container is constrained below 1.5GB RAM.
GUNICORN_WORKERS=2
CELERY_WORKER_CONCURRENCY=2
# Migration safety switches. Disable these while validating a parallel AIO
# service against production dependencies; enable them only during cutover.
ENABLE_MIGRATOR=1
ENABLE_WORKER=1
ENABLE_BEAT=1
# Set to 1 only on a parallel validation service that shares production
# dependencies. Keep 0 on the real production service during cutover.
SKIP_API_BOOTSTRAP=0

# --- Internal-only product policy --------------------------------------------
# Hotone Japan uses one invite-only workspace and does not publish public Space pages.
ENABLE_SIGNUP=0
DISABLE_WORKSPACE_CREATION=1
ENABLE_SPACE=0
# Keep Live enabled while Pages collaborative editing is in use.
# ENABLE_LIVE=0

# --- Web product policy (build-time) -----------------------------------------
# Comma-separated project UUIDs. Empty means Modules stay hidden everywhere.
# Changing this requires a new deployment so the Web bundle is rebuilt.
VITE_MODULE_PILOT_PROJECT_IDS=

# --- Misc --------------------------------------------------------------------
API_KEY_RATE_LIMIT=60/minute
# Trust only private/edge proxies so clients can't spoof X-Forwarded-For
# (which would defeat rate limiting / real-IP logging). Railway's edge is private.
TRUSTED_PROXIES=private_ranges
