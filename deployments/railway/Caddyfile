# Plane All-In-One reverse proxy for Railway.
#
# Railway terminates TLS at its edge and forwards plain HTTP to this container
# on $PORT, so we bind to a bare port (SITE_ADDRESS=":$PORT", set in start.sh).
# A bare-port site address tells Caddy to serve HTTP only — no ACME / no certs.
{
	auto_https off
	servers {
		max_header_size 25MB
		client_ip_headers X-Forwarded-For X-Real-IP
		trusted_proxies static {$TRUSTED_PROXIES:private_ranges}
	}
}

{$SITE_ADDRESS::80} {
	request_body {
		max_size {$FILE_SIZE_LIMIT:5242880}
	}

	# Compress text responses at the edge of the container. Caddy negotiates
	# zstd when the client supports it and falls back to gzip for older clients.
	encode zstd gzip

	# Railway readiness: require both the mounted Admin artifact and a Django
	# process that can execute a database query before the deployment is active.
	handle /health {
		root * /app/admin
		@admin_missing not file /index.html
		respond @admin_missing "admin unavailable" 503
		rewrite * /health/ready/
		reverse_proxy localhost:3004
	}

	# Public share app (SSR) — websockets pass through automatically.
	handle /spaces/* {
		reverse_proxy localhost:3002
	}

	# Real-time collaboration (websockets).
	handle /live/* {
		reverse_proxy localhost:3005
	}

	# Django API + auth.
	handle /api/* {
		reverse_proxy localhost:3004
	}
	handle /auth/* {
		reverse_proxy localhost:3004
	}

	# Content-addressed bundles bypass the SPA fallbacks. If a browser asks for
	# a bundle from an older deployment, file_server returns a real 404 instead
	# of serving index.html with a JavaScript URL and an immutable cache header.
	handle_path /god-mode/assets/* {
		root * /app/admin/assets
		route {
			try_files {path} =404
			header Cache-Control "public, max-age=31536000, immutable"
			file_server
		}
	}
	handle /assets/* {
		root * /app/web
		route {
			try_files {path} =404
			header Cache-Control "public, max-age=31536000, immutable"
			file_server
		}
	}
	handle /workbox-*.js {
		root * /app/web
		route {
			try_files {path} =404
			header Cache-Control "public, max-age=31536000, immutable"
			file_server
		}
	}
	handle /sw.js {
		root * /app/web
		route {
			try_files {path} =404
			header Cache-Control "no-cache"
			file_server
		}
	}

	# Admin panel (static SPA).
	redir /god-mode /god-mode/ 308
	handle_path /god-mode/* {
		root * /app/admin
		try_files {path} {path}/ /index.html
		header Cache-Control "no-cache"
		header X-Plane-App admin
		file_server
	}

	# Main web app (static SPA) — everything else.
	handle_path /* {
		root * /app/web
		try_files {path} {path}/ /index.html
		header Cache-Control "no-cache"
		file_server
	}
}
