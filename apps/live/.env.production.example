# Live 服务生产环境变量模板
# 部署到 Railway 时，在服务 Variables 中配置以下变量（不要提交真实值到 Git）

PORT=3000
API_BASE_URL="https://htjpplane-api-production.up.railway.app"
CORS_ALLOWED_ORIGINS="https://task.hotone.jp,https://htjpplane-web-production.up.railway.app"
LIVE_BASE_PATH="/live"
LIVE_SERVER_SECRET_KEY="<随机生成强密钥>"
REDIS_URL="redis://default:xxx@xxx.railway.internal:6379"
