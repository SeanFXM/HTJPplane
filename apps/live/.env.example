PORT=3100

# 主 API 服务地址（Live 用于验证用户身份）
API_BASE_URL="http://localhost:8000"

# CORS：允许连接 WebSocket 的前端地址，多个用逗号分隔
# 本地开发时包含 http://localhost:3000；生产环境用 https 地址
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://localhost:3001"

LIVE_BASE_PATH="/live"

# 密钥，生产环境务必使用强随机字符串
LIVE_SERVER_SECRET_KEY="secret-key"

# Redis（必须配置，用于多实例同步）
# 方式一：直接指定 REDIS_URL
REDIS_URL="redis://localhost:6379/"
# 方式二：分别指定
# REDIS_HOST=localhost
# REDIS_PORT=6379
