# apps/web/Dockerfile.web.railway
FROM node:22-bullseye-slim

WORKDIR /app

# 1) 基础工具
RUN corepack enable

# 2) 先拷贝依赖文件（提高缓存命中）
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY apps/web/package.json apps/web/package.json
COPY packages packages

# 3) 安装依赖（用 pnpm）
RUN corepack prepare pnpm@10.30.2 --activate
RUN pnpm install --frozen-lockfile

# 4) 拷贝剩余代码
COPY . .

# 4.5) 构建时注入 API 等 URL（Railway Variables 需映射为 Build Args）
ARG VITE_API_BASE_URL=""
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL

# 5) 确保 web 的 .env 存在（你已经建了就不会影响）
RUN test -f /app/apps/web/.env || (mkdir -p /app/apps/web && echo "# generated for CI" > /app/apps/web/.env)

# 只构建 web（不要全仓库 pnpm build，否则会拉起 admin/live/space）
RUN pnpm -C packages/i18n build \
 && pnpm -C packages/constants build \
 && pnpm -C packages/logger build \
 && pnpm -C packages/types build \
 && pnpm -C packages/hooks build \
 && pnpm -C packages/utils build \
 && pnpm -C packages/services build \
 && pnpm -C packages/shared-state build \
 && pnpm -C packages/propel build \
 && pnpm -C packages/ui build \
 && pnpm -C packages/editor build \
 && pnpm -C packages/tailwind-config build || true

# web 自己 build（关键）
RUN pnpm -C apps/web run build

# 7) 启动 web
WORKDIR /app/apps/web
EXPOSE 3000
CMD ["pnpm", "start"]
