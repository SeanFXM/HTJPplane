# apps/web/Dockerfile.web.railway
FROM node:22-bullseye-slim

WORKDIR /app

# 1) 基础工具
RUN corepack enable

# 2) 先拷贝依赖文件（提高缓存命中）
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY apps/web/package.json apps/web/package.json
COPY packages packages

# 3) 安装依赖（用 pnpm）
RUN corepack prepare pnpm@10.30.2 --activate
RUN pnpm install --frozen-lockfile

# 4) 拷贝剩余代码
COPY . .

# 5) 确保 web 的 .env 存在（你已经建了就不会影响）
RUN test -f /app/apps/web/.env || (mkdir -p /app/apps/web && echo "# generated for CI" > /app/apps/web/.env)

# 6) 构建（按官方 monorepo 的 build）
RUN pnpm build

# 7) 启动 web
WORKDIR /app/apps/web
EXPOSE 3000
CMD ["pnpm", "start"]
