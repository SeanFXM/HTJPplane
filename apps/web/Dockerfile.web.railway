# apps/web/Dockerfile.web.railway
FROM node:22-bullseye-slim AS builder

WORKDIR /app

# 1) 基础工具
RUN corepack enable

# 2) 先拷贝依赖文件（提高缓存命中）
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY apps/web/package.json apps/web/package.json
COPY apps/admin/package.json apps/admin/package.json
COPY packages packages

# 3) 安装依赖（用 pnpm）
RUN corepack prepare pnpm@10.30.2 --activate
RUN pnpm install --frozen-lockfile

# 4) 拷贝剩余代码
COPY . .

# 4.5) 构建时注入 API 等 URL（Railway Variables 需映射为 Build Args）
ARG VITE_API_BASE_URL=""
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL

ARG VITE_WEB_BASE_URL=""
ENV VITE_WEB_BASE_URL=$VITE_WEB_BASE_URL

ARG VITE_ADMIN_BASE_URL=""
ENV VITE_ADMIN_BASE_URL=$VITE_ADMIN_BASE_URL

ARG VITE_ADMIN_BASE_PATH="/god-mode"
ENV VITE_ADMIN_BASE_PATH=$VITE_ADMIN_BASE_PATH

ARG VITE_SPACE_BASE_URL=""
ENV VITE_SPACE_BASE_URL=$VITE_SPACE_BASE_URL

ARG VITE_SPACE_BASE_PATH="/spaces"
ENV VITE_SPACE_BASE_PATH=$VITE_SPACE_BASE_PATH

ARG VITE_LIVE_BASE_URL=""
ENV VITE_LIVE_BASE_URL=$VITE_LIVE_BASE_URL

ARG VITE_LIVE_BASE_PATH="/live"
ENV VITE_LIVE_BASE_PATH=$VITE_LIVE_BASE_PATH

ARG VITE_MODULE_PILOT_PROJECT_IDS=""
ENV VITE_MODULE_PILOT_PROJECT_IDS=$VITE_MODULE_PILOT_PROJECT_IDS

# 5) 确保 web 的 .env 存在（你已经建了就不会影响）
RUN test -f /app/apps/web/.env || (mkdir -p /app/apps/web && echo "# generated for CI" > /app/apps/web/.env)

# 只构建 web（不要全仓库 pnpm build，否则会拉起 admin/live/space）
RUN pnpm -C packages/i18n build \
 && pnpm -C packages/constants build \
 && pnpm -C packages/logger build \
 && pnpm -C packages/types build \
 && pnpm -C packages/hooks build \
 && pnpm -C packages/utils build \
 && pnpm -C packages/services build \
 && pnpm -C packages/shared-state build \
 && pnpm -C packages/propel build \
 && pnpm -C packages/ui build \
 && pnpm -C packages/editor build
# Note: packages/tailwind-config has no build script (pure config) — intentionally
# not built here. The chain is strict (no `|| true`) so a real package build failure fails the image.

# Reject incomplete critical translations before producing a release image.
RUN pnpm --filter=@plane/i18n check:critical-keys

# Build both static SPAs. Production links God Mode on the same origin under
# /god-mode, so a web-only image would route those URLs back to the web SPA.
RUN pnpm -C apps/web run build \
 && pnpm -C apps/admin run build \
 && node apps/admin/verify-production-build.mjs apps/admin/build/client /god-mode/

# 7) Serve web + God Mode with distinct SPA fallbacks.
FROM nginx:1.29-alpine AS production

COPY apps/web/nginx/nginx.railway.conf /etc/nginx/nginx.conf
COPY --from=builder /app/apps/web/build/client /usr/share/nginx/html
COPY --from=builder /app/apps/admin/build/client /usr/share/nginx/html/god-mode

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget -qO- http://127.0.0.1:3000/god-mode/general | grep -q '"basename":"/god-mode/"' || exit 1

CMD ["nginx", "-g", "daemon off;"]
